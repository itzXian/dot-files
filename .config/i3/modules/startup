#!/usr/bin/env bash

run='i3-msg exec'

lock='i3lock-fancy -n && $temporarily_run xmodmap ~/.xmodmaprc'
$run xss-lock --transfer-sleep-lock --ignore-sleep -- $lock

# restore brightness
$run sudo xbacklight -set $(cat ~/.config/i3status/brightness | sed 's/%//')

$run blueman-applet
$run mpris-proxy

$run /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

$run keynav
$run unclutter

$run localsend
$run flclash

