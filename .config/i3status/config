# i3status configuration file.
# see "man i3status" for documentation.

# vim:noet:ts=32:sts=32

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
  markup	= pango
  separator	= ""
  colors	= true
  color_good	= "#FFFFFF"
  color_degraded	= "#CCCCCC"
  color_bad	= "#9397CB"
  interval	= 5
}

order += "read_file checkupdates"
#order += "ipv6"
#order += "load"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "uptime"
#order += "ethernet _first_"
#order += "wireless _first_"
#order += "volume viper"
#order += "volume hdmi"
order += "volume master"
order += "read_file brightness"
#order += "read_file date"
order += "tztime date"
#order += "read_file time"
order += "tztime time"
order += "battery 0"

ipv6 {
  format_down	=""
}

wireless _first_ {
  format_up	= "<span foreground='#00000033' background='#FFFFFFCC'>     %ip    </span>"
  format_down	= "<span foreground='#00000033' background='#FFFFFFCC'>     NONE    </span>"
}

ethernet _first_ {
  format_up	= "  %ip"
  format_down	= "  NONE"
}

battery 0 {
  format	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span><span foreground='#FFFFFFCC' background='#FFFFFF66'>  %percentage  </span>"
  path	= "/sys/class/power_supply/BAT1/uevent"
  last_full_capacity	= true
  integer_battery_capacity	= true
  low_threshold	= 20
  threshold_type = percentage
  hide_seconds = true
  status_chr = ""
  status_bat = ""
  status_full = ""
}

disk "/" {
  format	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span><span foreground='#FFFFFFCC' background='#FFFFFF66'>  %avail  </span>"
}

load {
  #format	= "<span foreground='#00000033' background='#FFFFFFCC'>     %1min ░ %5min ░ %15min    </span>"
  format	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span><span foreground='#FFFFFFCC' background='#FFFFFF66'>  %1min ░ %5min ░ %15min  </span>"
}

cpu_usage {
  format	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span><span foreground='#FFFFFFCC' background='#FFFFFF66'>  %usage  </span>"
}

memory {
  format	= "<span foreground='#00000033' background='#FFFFFFCC'> 﫭 </span><span foreground='#FFFFFFCC' background='#FFFFFF66'>  %used  </span>"
  threshold_degraded	= "500M"
  format_degraded	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span><span foreground='#FFFFFFCC' background='#FFFFFF66'>  %used  </span>"
}

tztime local {
  format	= " %Y-%m-%d   %H:%M"
}

tztime custom {
  format	= "%a, %b %d    %H:%M"
}

tztime date {
  format	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span><span foreground='#FFFFFFCC' background='#FFFFFF66'> %F </span>"
}

tztime time {
  format	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span><span foreground='#FFFFFFCC' background='#FFFFFF66'> %H:%M </span>"
}

read_file date {
  format	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span>"
  path	= "/dev/null"
}

read_file time {
  format	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span>"
  path	= "/dev/null"
}

read_file update {
  path	= "/proc/uptime"
}

read_file brightness {
  format	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span><span foreground='#FFFFFFCC' background='#FFFFFF66'>  %content  </span>"
  path	= "/home/xian/.config/i3status/brightness"
}

read_file checkupdates {
  format	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span><span foreground='#FFFFFFCC' background='#FFFFFF66'>  %content  </span>"
  path	= "/home/xian/.config/i3status/checkupdates"
}

volume master {
  format	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span><span foreground='#FFFFFFCC' background='#FFFFFF66'>  %volume  </span>"
  format_muted	= "<span foreground='#00000033' background='#FFFFFFCC'>  </span><span foreground='#FFFFFFCC' background='#FFFFFF66'>  %volume  </span>"
  device	= "pulse:alsa_output.pci-0000_00_09.2.analog-stereo"
}

volume hdmi {
  format	= "HDMI: %volume"
  format_muted	= "HDMI: %volume"
  device	= "pulse:alsa_output.pci-0000_00_01.1.hdmi-stereo"
}

volume viper {
  format	= "<span foreground='#00000033' background='#FFFFFFCC'>     %volume    </span>"
  format_muted	= "<span foreground='#00000033' background='#FFFFFFCC'>     %volume    </span>"
  device	= "pulse:viper"
}
